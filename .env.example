# Server Port
PORT=3000

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas cluster connection string:
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/college_db?retryWrites=true&w=majority

# JWT Secret for Admin Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Default Initial Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_EMAIL=admin@college.edu
ADMIN_NAME=Chief Institutional Administrator
